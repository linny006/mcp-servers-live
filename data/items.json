      "claude_config": "{\n  \"mcpServers\": {\n    \"ytdl-rmcp\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"ytdl-rmcp\"],\n      \"env\": {\n        \"YTDLP_TARGET_PATH\": \"tootie:/mnt/user/data/media/music/yt-dlp\",\n        \"YTDLP_VIDEO_TARGET_PATH\": \"tootie:/mnt/user/data/media/movies/yt-dlp\",\n        \"YTDLP_AUTO_UPDATE\": \"1\",\n        \"YTDLP_MAX_AGE_DAYS\": \"1\",\n        \"YTDLP_EXTRACTOR_ARGS\": \"youtube:player_client=android\"\n      }\n    }\n  }\n}",
      "install_cmd": "claude mcp add -s user ytdl-rmcp -e YTDLP_TARGET_PATH=tootie:/media/music -e YTDLP_EXTRACTOR_ARGS=youtube:player_client=android -- npx -y ytdl-rmcp",
      "install_kind": "claude mcp add"
