  {
    "description": "Serve multiple stdio MCP servers from one container: path routing, hub meta-tools, OAuth 2.1 + API tokens for ChatGPT, C",
    "id": "ni-c/mcp-hub",
    "install_info": {
      "claude_config": "{\n  \"mcpServers\": {\n    \"paperless\": {\n      \"command\": \"paperless-mcp\",\n      \"args\": [],\n      \"env\": { \"PAPERLESS_API_TOKEN\": \"${PAPERLESS_API_TOKEN}\" }\n    },\n    \"homeassistant\": {\n      \"type\": \"http\",\n      \"url\": \"http://homeassistant:8123/api/mcp\",\n      \"headers\": { \"Authorization\": \"Bearer ${HA_TOKEN}\" }\n    },\n    \"private-thing\": { \"command\": \"some-mcp\", \"args\": [], \"hub\": false },\n    \"paperless-readonly\": {\n      \"command\": \"paperless-mcp\",\n      \"allowTools\": [\"search_*\", \"get_document\"],\n      \"denyTools\": [\"delete_document\"]\n    },\n    \"untrusted\": {\n      \"type\": \"docker\",\n      \"image\": \"ghcr.io/example/untrusted-mcp@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\",\n      \"network\": \"none\",\n      \"memory\": \"256m\"\n    }\n  }\n}",
      "install_cmd": "npm install\nnpm",
      "install_kind": "npm install"
    },
    "language": "TypeScript",
    "name": "ni-c/mcp-hub",
    "stars": 0,
    "updated_at": "2026-09-06T14:44:02Z",
    "url": "https://github.com/ni-c/mcp-hub"
  },
