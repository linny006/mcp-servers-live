_CONTROLTOOL\": \"True\",\n        \"TABLE_APITOOL\": \"True\",\n        \"TESTINGTOOL\": \"True\",\n        \"UPDATE_SETSTOOL\": \"True\"\n      }\n    }\n  }\n}",
