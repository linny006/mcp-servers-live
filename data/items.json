  {
    "description": "One MCP server fronting many: 7 meta-tools with lazy schema discovery slash context-token costs. Allow/deny governance, ",
    "id": "JohGirard/mcp-multiplexer",
    "install_info": {
      "claude_config": "{\n  \"$schema\": \"https://raw.githubusercontent.com/johgirard/mcp-multiplexer/main/schema.json\",\n  \"mcpServers\": {\n    \"filesystem\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \"/home/me/docs\"],\n      \"allow\": [\"read_file\", \"list_directory\"]\n    },\n    \"github\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-github\"],\n      \"env\": { \"GITHUB_TOKEN\": \"${GITHUB_TOKEN}\" }\n    },\n    \"web\": {\n      \"url\": \"https://example.com/mcp\",\n      \"headers\": { \"Authorization\": \"Bearer ${API_TOKEN}\" },\n      \"deny\": [\"admin_*\"]\n    },\n    \"linear\": {\n      \"url\": \"https://mcp.linear.app/mcp\",\n      \"oauth\": true\n    },\n    \"fast\": {\n      \"command\": \"mcp-fast-server\",\n      \"expose\": true\n    }\n  }\n}",
      "install_cmd": "cargo install mcp-multiplexer",
      "install_kind": "cargo install"
    },
    "language": "Rust",
    "name": "JohGirard/mcp-multiplexer",
    "stars": 1,
    "updated_at": "2026-09-08T12:26:21Z",
    "url": "https://github.com/JohGirard/mcp-multiplexer"
  },
