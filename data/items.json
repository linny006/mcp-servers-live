    "description": "GitLab MCP Server and Python API Wrapper",
    "id": "Knuckles-Team/gitlab-api",
    "install_info": {
      "claude_config": "{\n  \"mcpServers\": {\n    \"gitlab-mcp\": {\n      \"command\": \"uvx\",\n      \"args\": [\n        \"--from\",\n        \"gitlab-api[mcp]\",\n        \"gitlab-mcp\"\n      ],\n      \"env\": {\n        \"MCP_TOOL_MODE\": \"intent\",\n        \"BRANCHESTOOL\": \"True\",\n        \"COMMITSTOOL\": \"True\",\n        \"CUSTOM_APITOOL\": \"True\",\n        \"DEPLOY_TOKENSTOOL\": \"True\",\n        \"ENVIRONMENTSTOOL\": \"True\",\n        \"EPICSTOOL\": \"True\",\n        \"GITLAB_TOKEN\": \"your_gitlab_token_here\",\n        \"GITLAB_URL\": \"https://gitlab.example.com\",\n        \"GRAPHQLTOOL\": \"True\",\n        \"GRAPHQL_OPSTOOL\": \"True\",\n        \"GROUPSTOOL\": \"True\",\n        \"ISSUESTOOL\": \"True\",\n        \"JOBSTOOL\": \"True\",\n        \"LABELSTOOL\": \"True\",\n        \"MEMBERSTOOL\": \"True\",\n        \"MERGE_REQUESTSTOOL\": \"True\",\n        \"MERGE_RULESTOOL\": \"True\",\n        \"MILESTONESTOOL\": \"True\",\n        \"MISCTOOL\": \"True\",\n        \"NAMESPACESTOOL\": \"True\",\n        \"NOTESTOOL\": \"True\",\n        \"PACKAGESTOOL\": \"True\",\n        \"PIPELINESTOOL\": \"True\",\n        \"PIPELINE_SCHEDULESTOOL\": \"True\",\n        \"PROJECTSTOOL\": \"True\",\n        \"PROTECTED_BRANCHESTOOL\": \"True\",\n        \"RELEASESTOOL\": \"True\",\n        \"RUNNERSTOOL\": \"True\",\n        \"SNIPPETSTOOL\": \"True\",\n        \"TAGSTOOL\": \"True\",\n        \"USERSTOOL\": \"True\",\n        \"VULNERABILITIESTOOL\": \"True\",\n        \"WIKITOOL\": \"True\"\n      }\n    }\n  }\n}",
      "install_cmd": "docker run -i --rm \\",
      "install_kind": "docker run"
    },
    "language": "Python",
    "name": "Knuckles-Team/gitlab-api",
    "stars": 10,
    "updated_at": "2026-10-23T04:28:16Z",
    "url": "https://github.com/Knuckles-Team/gitlab-api"
  },
